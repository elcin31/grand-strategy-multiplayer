{
  "name": "grand-strategy-multiplayer",
  "version": "0.6.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "benchmark:map": "node --import tsx scripts/benchmark-map.ts",
    "benchmark:world": "node --import tsx scripts/benchmark-world.ts",
    "test:long": "node --expose-gc --import tsx scripts/long-simulation.ts"
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.17",
    "expo-file-system": "57.0.7",
    "expo-secure-store": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  }
}
