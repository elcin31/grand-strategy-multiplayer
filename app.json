{
  "expo": {
    "name": "Dominion",
    "slug": "grand-strategy-multiplayer",
    "version": "2.3.0-dev.12",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.elcin31.grandstrategymultiplayer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/dominion-adaptive-foreground.png",
        "backgroundColor": "#0B2030"
      },
      "versionCode": 27,
      "icon": "./assets/icon/dominion.png"
    },
    "plugins": [
      "expo-secure-store",
      "./plugins/withMapTextureOpacity.cjs",
      "./plugins/withSkiaRecorderLifecycle.cjs",
      "./plugins/withSkiaTextureConsumer.cjs",
      "./plugins/withSkiaSwapPacing.cjs",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "icon": "./assets/icon/dominion.png"
  }
}
